<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ApnaRent</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm py-2 px-3 sticky-top">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    🏷️ ApnaRent
                </a>


                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link navbar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link navbar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "About" ? "active" : "")"
                               asp-controller="Home" asp-action="About">
                                About Us
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link navbar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "RentalPolicy" ? "active" : "")"
                               asp-controller="Home" asp-action="RentalPolicy">
                                Rental Policy
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link navbar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "FAQ" ? "active" : "")"
                               asp-controller="Home" asp-action="FAQ">
                                FAQ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link navbar-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Guarantee" ? "active" : "")"
                               asp-controller="Home" asp-action="Guarantee">
                                Guarantee
                            </a>
                        </li>
                    </ul>


                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Item" asp-action="Create" class="btn btn-primary btn-sm rounded-pill px-3">
                            + Add Item
                        </a>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Saved" asp-action="Index" class="heart-nav-btn" title="Saved Items">🤍</a>
                            @await Component.InvokeAsync("MessagesBell")
                            @await Component.InvokeAsync("NotificationBell")

                            <div class="dropdown">
                                <button class="btn btn-light rounded-circle dots-btn" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-fill"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Auth" asp-action="Profile">
                                            <div class="fw-semibold">@User.Identity.Name</div>
                                            <div class="small text-muted">View Profile</div>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Booking" asp-action="MyBookings">My Bookings</a></li>
                                    <li><a class="dropdown-item" asp-controller="Item" asp-action="Index">My Items</a></li>
                                    <li><a class="dropdown-item" asp-controller="Booking" asp-action="MyItemRequests">Rental Requests</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                                            Logout
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="btn btn-light rounded-circle dots-btn" title="Login">
                                <i class="bi bi-person-fill"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid px-0 main-content-offset">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @if (ViewData["HideFooter"] as bool? != true)
    {
        <partial name="_Footer" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>