@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<h5 class="auth-heading">Forgot Password?</h5>
<p class="auth-subtext">Enter your registered email and we'll send you an OTP to reset your password.</p>

@if (ViewBag.Error != null)
{
    <div class="auth-alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@ViewBag.Error</span>
    </div>
}

<form method="post" asp-controller="Auth" asp-action="ForgotPassword">

    <div class="auth-field">
        <label class="auth-label">Email address</label>
        <div class="input-icon-group">
            <i class="bi bi-envelope"></i>
            <input class="form-control"
                   type="email"
                   name="email"
                   placeholder="example@email.com"
                   required />
        </div>
    </div>

    <button type="submit" class="btn-auth-primary">
        <i class="bi bi-send"></i> Send OTP
    </button>

    <p class="auth-bottom-text">
        Remembered your password?
        <a asp-action="Login" class="auth-link">Back to Login</a>
    </p>
</form>