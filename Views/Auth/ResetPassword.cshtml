@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<h5 class="auth-heading">Set a new password</h5>
<p class="auth-subtext">Enter a new password for <b>@ViewBag.Email</b></p>

@if (ViewBag.Error != null)
{
    <div class="auth-alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@ViewBag.Error</span>
    </div>
}

<form method="post" asp-controller="Auth" asp-action="ResetPassword">

    <input type="hidden" name="email" value="@ViewBag.Email" />

    <div class="auth-field">
        <label class="auth-label">New Password</label>
        <div class="input-icon-group">
            <i class="bi bi-lock"></i>
            <input class="form-control"
                   type="password"
                   name="newPassword"
                   id="newPassword"
                   placeholder="Enter new password"
                   required />
            <button type="button" class="toggle-pass" data-target="newPassword">
                <i class="bi bi-eye"></i>
            </button>
        </div>
    </div>

    <button type="submit" class="btn-auth-primary">
        <i class="bi bi-shield-lock"></i> Reset Password
    </button>

    <p class="auth-bottom-text">
        <a asp-action="Login" class="auth-link">Back to Login</a>
    </p>
</form>