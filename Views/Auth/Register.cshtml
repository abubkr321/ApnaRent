@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
}

<h5 class="auth-heading">Create your account</h5>
<p class="auth-subtext">Join ApnaRent and start renting or listing in minutes.</p>

@if (ViewBag.Error != null)
{
    <div class="auth-alert">
        <i class="bi bi-exclamation-circle-fill"></i>
        <span>@ViewBag.Error</span>
    </div>
}

<form method="post" asp-controller="Auth" asp-action="Register">

    <div class="auth-field">
        <label class="auth-label">Full Name</label>
        <div class="input-icon-group">
            <i class="bi bi-person"></i>
            <input class="form-control"
                   type="text"
                   name="fullName"
                   placeholder="Your full name"
                   required />
        </div>
    </div>

    <div class="auth-field">
        <label class="auth-label">Email address</label>
        <div class="input-icon-group">
            <i class="bi bi-envelope"></i>
            <input class="form-control"
                   type="email"
                   name="email"
                   placeholder="example@email.com"
                   required />
        </div>
    </div>

    <div class="auth-field">
        <label class="auth-label">Password</label>
        <div class="input-icon-group">
            <i class="bi bi-lock"></i>
            <input class="form-control"
                   type="password"
                   name="password"
                   id="regPassword"
                   placeholder="Create a password"
                   required />
            <button type="button" class="toggle-pass" data-target="regPassword">
                <i class="bi bi-eye"></i>
            </button>
        </div>
    </div>

    <button type="submit" class="btn-auth-primary">
        <i class="bi bi-person-plus"></i> Register
    </button>

    <p class="auth-bottom-text">
        Already have an account?
        <a asp-action="Login" class="auth-link">Login</a>
    </p>
</form>