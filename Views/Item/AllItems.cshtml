@model List<Item>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3 class="fw-bold mb-0">All Items</h3>

        <div class="d-flex gap-2">
            <select class="form-select" style="width:200px;" onchange="if(this.value) window.location.href=this.value;">
                <option value="/Item/AllItems">All Categories</option>
                @if (ViewBag.Categories != null)
                {
                    @foreach (var cat in ViewBag.Categories as List<Category>)
                    {
                        <option value="/Item/AllItems?categoryId=@cat.Id" selected="@(ViewBag.SelectedCategoryId == cat.Id)">
                            @cat.Name
                        </option>
                    }
                }
            </select>

            <form asp-controller="Item" asp-action="AllItems" method="get" class="d-flex" style="max-width:250px;">
                @if (ViewBag.SelectedCategoryId != null)
                {
                    <input type="hidden" name="categoryId" value="@ViewBag.SelectedCategoryId" />
                }
                <input type="text" name="search" class="form-control me-2" placeholder="Search..." value="@ViewBag.SearchTerm" />
                <button class="btn btn-outline-primary" type="submit">Search</button>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center text-muted py-5">
            <p class="mb-0">No items found.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    @await Html.PartialAsync("_ItemCard", item)
                </div>
            }
        </div>
    }
</div>