@model List<ApnaRent.Models.UserManagementVM>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0">Users</h3>
    <span class="badge status-approved">@Model.Count total</span>
</div>

<div class="admin-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Bookings Made</th>
                    <th>Items Listed</th>
                    <th>View</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr>
                        <td class="d-flex align-items-center gap-2">
                            <div class="rounded-circle d-flex align-items-center justify-content-center"
                                 style="width:36px;height:36px;background:var(--admin-primary);color:#fff;">
                                <i class="bi bi-person-fill"></i>
                            </div>
                            <a asp-action="Details" asp-route-id="@u.UserId" class="link-user">@u.FullName</a>
                        </td>
                        <td>@u.Email</td>
                        <td><span class="status-badge status-active">@u.Role</span></td>
                        <td>@u.BookingCount</td>
                        <td>@u.ItemsListedCount</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@u.UserId" class="btn btn-sm btn-teal">
                                <i class="bi bi-eye"></i> Profile
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>