@{
    ViewData["Title"] = "Guarantee";
}

<div class="container py-5 text-center">
    <h2 class="fw-bold mb-3">Rent with Confidence</h2>
    <p class="text-muted mb-5">Every booking on ApnaRent is backed by our protection guarantee.</p>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="trust-icon mx-auto" style="background:var(--primary)">🛡️</div>
            <h6 class="mt-3">Verified Users</h6>
            <p class="small text-muted">Every user completes OTP-based identity verification before using the platform.</p>
        </div>
        <div class="col-md-4">
            <div class="trust-icon mx-auto" style="background:var(--primary)">📅</div>
            <h6 class="mt-3">Date-Protected Bookings</h6>
            <p class="small text-muted">No overlapping bookings — your rental period is always guaranteed and conflict-free.</p>
        </div>
        <div class="col-md-4">
            <div class="trust-icon mx-auto" style="background:var(--primary)">✅</div>
            <h6 class="mt-3">Admin-Reviewed Listings</h6>
            <p class="small text-muted">All new items are checked by admin before going live on the platform.</p>
        </div>
    </div>
</div>