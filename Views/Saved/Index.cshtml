@model List<ApnaRent.Models.SavedItem>

<div class="container py-4">
    <h4 class="fw-bold mb-4">Saved Items</h4>

    @if (!Model.Any())
    {
        <p class="text-muted">No saved items yet.</p>
    }
    else
    {
        <div class="row g-4">
            @foreach (var s in Model)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    @await Html.PartialAsync("_ItemCard", s.Item)
                </div>
            }
        </div>
    }
</div>a