@{
    Layout = User.IsInRole("Admin") ? "_AdminLayout" : "_Layout";
    ViewData["Title"] = User.IsInRole("Admin") ? "Items" : "My Items";
}

@model IEnumerable<ApnaRent.Models.Item>
@{
    var rentedIds = ViewBag.RentedItemIds as HashSet<int> ?? new HashSet<int>();
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="@(User.IsInRole("Admin") ? "" : "container py-4")">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="fw-bold mb-0">@(User.IsInRole("Admin") ? "All Items" : "My Items")</h3>
        <a asp-action="Create" class="btn btn-teal btn-sm">+ Add Item</a>
    </div>

    <div class="row g-3">
        @foreach (var item in Model)
        {
            bool isRented = rentedIds.Contains(item.Id);
            bool canEdit = item.OwnerId == currentUserId;

            <div class="col-md-6 col-lg-2">
                <div class="admin-card p-0 overflow-hidden h-100 d-flex flex-column">
                    <a asp-action="Details" asp-controller="Item" asp-route-id="@item.Id" class="item-thumb d-block">
                        @if (!string.IsNullOrEmpty(item.ImagePath))
                        {
                            <img src="@item.ImagePath" alt="@item.Name" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100">
                                <i class="bi bi-image text-muted fs-1"></i>
                            </div>
                        }
                    </a>
                    <div class="p-3 d-flex flex-column flex-grow-1">
                        <a asp-action="Details" asp-controller="Item" asp-route-id="@item.Id" class="link-user mb-1">@item.Name</a>
                        @if (User.IsInRole("Admin"))
                        {
                            <p class="small text-muted mb-1">Owner: @(item.Owner?.FullName ?? "—")</p>
                        }
                        <p class="fw-semibold mb-2" style="color:var(--admin-accent, #E76F51);">Rs @item.PricePerDay /day</p>

                        <div class="d-flex gap-2 mb-2">
                            <span class="status-badge status-@item.ApprovalStatus.ToLower()">@item.ApprovalStatus</span>
                            <span class="status-badge @(item.AvailabilityCount > 0 ? "status-approved" : "status-rejected")">
                                @(item.AvailabilityCount > 0 ? "Available" : "Unavailable")
                            </span>
                        </div>

                        <div class="mt-auto d-flex gap-2 flex-wrap">
                            <a asp-action="Details" asp-controller="Item" asp-route-id="@item.Id" class="btn btn-sm btn-blue flex-grow-1">View</a>
                            @if (canEdit)
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-teal flex-grow-1">Edit</a>
                            }
                            @if (isRented)
                            {
                                <span class="btn btn-sm btn-outline-secondary disabled">Rented</span>
                            }
                            else
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"
                                   onclick="return confirm('Are you sure?')">Delete</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>